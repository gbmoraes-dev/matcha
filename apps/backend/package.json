{
  "name": "@matcha/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/http/server.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/http/server.ts",
    "start": "./server",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "elysia": "1.4.30",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@elysia/eden": "1.4.10",
    "@types/bun": "1.4.3",
    "pino-pretty": "13.2.0"
  }
}
