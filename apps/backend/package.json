{
  "name": "@matcha/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "bun --watch src/http/server.ts",
    "dev:worker": "bun --watch src/worker/subscriber.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile matcha src/main.ts",
    "start:server": "./matcha api",
    "start:worker": "./matcha worker",
    "start:migrate": "./matcha migrate",
    "email": "email dev --dir src/mailer/templates --port 3030",
    "typecheck": "tsc --noEmit",
    "pretest": "bun --env-file=.env.test db:migrate",
    "test": "bun --env-file=.env.test test",
    "db:generate": "bun --bun --env-file=.env.local drizzle-kit generate",
    "db:migrate": "bun --bun --env-file=.env.local drizzle-kit migrate",
    "db:studio": "bun --bun --env-file=.env.local drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.16",
    "@react-email/components": "1.0.12",
    "drizzle-orm": "1.0.0-rc.4",
    "elysia": "1.4.30",
    "elysia-rate-limit": "5.1.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "rabbitmq-client": "5.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@elysia/eden": "1.4.10",
    "@react-email/ui": "6.11.3",
    "@types/bun": "1.4.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "drizzle-kit": "1.0.0-rc.4",
    "pino-pretty": "13.2.0",
    "react-email": "6.11.3"
  }
}
