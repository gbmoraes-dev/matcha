{
  "name": "matcha",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "backend:dev:api": "bun --filter @matcha/backend dev:api",
    "backend:dev:worker": "bun --filter @matcha/backend dev:worker",
    "backend:email": "bun --filter @matcha/backend email",
    "backend:start:server": "bun --filter @matcha/backend start:server",
    "backend:start:worker": "bun --filter @matcha/backend start:worker",
    "backend:db:generate": "bun --filter @matcha/backend db:generate",
    "backend:db:migrate": "bun --filter @matcha/backend db:migrate",
    "backend:db:studio": "bun --filter @matcha/backend db:studio",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  }
}
